Screen {
    min-width: 50;
    min-height: 50;
    align: center middle;
    border: round $primary;
}

#maze-container {
    width: 100%;
    height: 1fr;
    align: center middle;
}

#maze {
    width: auto;
    height: auto;
    color: $primary;
}

#controls {
    dock: bottom;
    width: 100%;
    height: auto;
}

.panel {
    width: 1fr;
    height: auto;
    border: round $primary;
    padding: 1;
    margin-bottom: 1;
}

Button:focus {
    text-style: none;
    color: $primary;
}

#actions Button {
    width: 100%;
    margin-bottom: 1;
}

#actions Button:last-of-type {
    margin-bottom: 0;
}

#actions-grid {
    layout: grid;
    grid-size: 6;
    grid-columns: 9 1fr 1fr 9 1fr 1fr;
    grid-rows: auto;
    grid-gutter: 0 1;
    width: 100%;
    height: auto;
}

#settings-grid {
    layout: grid;
    grid-size: 6;
    grid-columns: 9 1fr 1fr 9 1fr 1fr;
    grid-rows: auto;
    grid-gutter: 0 1;
    width: 100%;
    height: auto;
}

#settings-grid Label {
    width: 100%;
    height: 3;
    content-align: left middle;
}

#settings-grid ScrollInput,
#settings-grid Button {
    width: 100%;
    min-width: 0;
}

.span-2 { column-span: 2; }
.span-5 { column-span: 5; }

#style-label {
    margin-top: 1;
}

#style {
    width: 100%;
    height: 3;
}

#settings-grid ScrollInput,
#settings-grid Input,
#settings-grid Button {
    width: 100%;
    min-width: 0;
}

.span-2 { column-span: 2; }
.span-3 { column-span: 3; }
.span-5 { column-span: 5; }
